<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.1.0</Version>
    <Authors>Lofrano Tecnologia</Authors>
    <Company>Lofrano Tecnologia</Company>
    <Copyright>Copyright (c) 2026 Lofrano Tecnologia</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/martinlofranodeoliveira/resumable-transfer-lab</RepositoryUrl>
    <PackageProjectUrl>https://lofranotecnologia.com.br</PackageProjectUrl>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
</Project>
